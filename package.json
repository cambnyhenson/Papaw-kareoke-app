{
  "name": "karaoke-player",
  "productName": "Karaoke Player",
  "version": "1.3.0",
  "description": "Simple karaoke show player: MP3+G, CDG and MP4 with lyrics on the TV, key change, and a saved playlist.",
  "main": "main.js",
  "author": "John Camby Henson",
  "license": "UNLICENSED",
  "repository": "github:cambnyhenson/Papaw-kareoke-app",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.ozarkmountainai.karaokeplayer",
    "productName": "Karaoke Player",
    "files": [
      "main.js",
      "preload.js",
      "library.js",
      "report.json",
      "reports.js",
      "src/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Karaoke Player",
      "artifactName": "Karaoke-Player-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cambnyhenson",
        "repo": "Papaw-kareoke-app",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
